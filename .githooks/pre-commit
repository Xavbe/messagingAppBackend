#!/usr/bin/env bash
set -euo pipefail

export PATH="/usr/bin:/bin:$PATH"

PLANTUML_JAR="scripts/plantuml.jar"
UML_DIR="docs/uml"
PUML_FILE="$UML_DIR/classes.puml"

mapfile -d '' STAGED_JAVA_FILES < <(
  git diff --cached --name-only -z --diff-filter=ACM -- '*.java'
)

if [ "${#STAGED_JAVA_FILES[@]}" -eq 0 ]; then
  exit 0
fi

run_gradle() {
  if command -v cmd.exe >/dev/null 2>&1 && [ -f "./gradlew.bat" ]; then
    cmd.exe //c gradlew.bat "$@"
  elif [ -f "./gradlew.bat" ]; then
    ./gradlew.bat "$@"
  else
    ./gradlew "$@"
  fi
}

emit_class() {
  local file="$1"
  local declaration package class_name kind stereotype

  declaration=$(grep -E -m1 '^[[:space:]]*public[[:space:]]+(abstract[[:space:]]+)?(class|interface|enum|record)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$file" || true)
  [ -n "$declaration" ] || return 0

  package=$(sed -nE 's/^package[[:space:]]+([^;]+);/\1/p' "$file" | head -n1)
  class_name=$(printf '%s\n' "$declaration" | sed -E 's/.*(class|interface|enum|record)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*).*/\2/')

  if printf '%s\n' "$declaration" | grep -q 'interface'; then
    kind="interface"
    stereotype=""
  elif printf '%s\n' "$declaration" | grep -q 'enum'; then
    kind="enum"
    stereotype=""
  elif printf '%s\n' "$declaration" | grep -q 'record'; then
    kind="class"
    stereotype=" <<record>>"
  elif printf '%s\n' "$declaration" | grep -q 'abstract class'; then
    kind="abstract class"
    stereotype=""
  else
    kind="class"
    stereotype=""
  fi

  if [ -n "$package" ]; then
    echo "package \"$package\" {"
  fi

  echo "$kind $class_name$stereotype {"

  sed -nE 's/^[[:space:]]*(private|protected|public)[[:space:]]+([^();=]+)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*(=.*)?;/  \1 \3 : \2/p' "$file" || true
  sed -nE 's/^[[:space:]]*(private|protected|public)[[:space:]]+([^();=]+)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\(.*/  \1 \3()/p' "$file" || true

  echo "}"

  if [ -n "$package" ]; then
    echo "}"
  fi

  echo ""
}

echo "Generating backend UML diagram..."
mkdir -p "$UML_DIR"

{
  echo "@startuml"
  echo "left to right direction"
  echo "skinparam classAttributeIconSize 0"
  echo "skinparam packageStyle rectangle"
  echo ""

  while IFS= read -r -d '' file; do
    emit_class "$file"
  done < <(find src/main/java -name '*.java' -print0)

  echo "@enduml"
} > "$PUML_FILE"

if [ ! -f "$PLANTUML_JAR" ]; then
  echo "Missing $PLANTUML_JAR"
  exit 1
fi

java -jar "$PLANTUML_JAR" -tpng "$PUML_FILE"
java -jar "$PLANTUML_JAR" -tsvg "$PUML_FILE"
git add "$PUML_FILE" "$UML_DIR/classes.png" "$UML_DIR/classes.svg"

echo "Running Checkstyle..."
run_gradle checkstyleMain checkstyleTest

echo "Pre-commit checks completed"
